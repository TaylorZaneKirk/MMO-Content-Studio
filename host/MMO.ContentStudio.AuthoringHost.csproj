<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900</WarningsNotAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>MMO.ContentStudio.AuthoringHost</AssemblyName>
    <RootNamespace>MMO.ContentStudio.AuthoringHost</RootNamespace>
    <Version>0.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../integrations/mmo-project/FarmingSettings.cs" Link="Contracts/FarmingSettings.cs" />
    <Compile Include="../integrations/mmo-project/CraftingSettings.cs" Link="Contracts/CraftingSettings.cs" />
    <Compile Include="../integrations/mmo-project/AlchemySettings.cs" Link="Contracts/AlchemySettings.cs" />
    <Compile Include="../integrations/mmo-project/BlacksmithingRecipe.cs" Link="Contracts/BlacksmithingRecipe.cs" />
  </ItemGroup>
</Project>
